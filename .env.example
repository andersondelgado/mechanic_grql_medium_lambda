# ==============================================================================
# PLANTILLA DE CONFIGURACION - MEDIUM-LAMBDA (.env.example)
# ==============================================================================

# Entorno de Ejecucion
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=0

# Backend y Pasarela gRQL
DOMAIN=https://db-grql.com
API_BASE_URL=https://db-grql.com
WS_URL=wss://db-grql.com

# Base de Datos y Propietario (Tenant)
DB=GestionTallerProd
DB_NAME=GestionTallerProd
DB_LAMBDAS=codeLambdas
DEFAULT_OWNER=50735380-0_urbaezmotors

# Credenciales de Seguridad y Autenticacion
API_KEY=your_grql_api_key_here
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# Composicion Modular de Lambdas (Base64 JSON)
LAMBDA_

# Endpoint de Invocacion Lambda Directo
LAMBDA_ENDPOINT=https://db-grql.com/api/secure-rQL/lambdas-json-run-node?db=codeLambdas&table=lambda&id=6d033980-4806-4e69-a3e8-a5f8f86d4cec&format=json

# Google Gemini AI Copilot de Taller
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
